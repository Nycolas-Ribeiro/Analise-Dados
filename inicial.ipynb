# passo a passo
# passo 1: Importar a base de dados

# pandas -> base de dados
# plotly -> criar arquivos dinamicos

import pandas 

tabela = pandas.read_csv("cancelamento_sample.csv")

# passo 2::visualizar a base de dados (2 objetivos: entender as informações + encontrar probelmas)

# informações inuteis - informações que não são uteis, te atrapalham
tabela = tabela.drop(columns = "CustomerID")
display(tabela)

# passo 3: resolver os proobelmas da base de dados
# informações no formato errado
# informações vazias
display(tabela.info())
tabela = tabela.dropna()
display(tabela.info())
# passo 4: análise inicial (quantos clientes cancelaram, qual o % de clientes)
display(tabela["cancelou"].value_counts())
# em percentual
display(tabela["cancelou"].value_counts(normalize=True))
# passo 5: análise a causa dos cancelamentos dos clientes

# quero entender como cada colunaa da base de dados impact no caancelamento do cliente.
# criando gráficos

import plotly.express as penis

for coluna in tabela.columns:
    #cria o grafico
    grafico = penis.histogram(tabela, x=coluna, color='cancelou', text_auto=True)
    #exibe o grafico
    grafico.show("")
    # clientees que ligaaram mais de 4x pro callcenter cancelam
# vamos cirar um alerta quando o cliente ligar a terceira vez pro call ceenter

#todos os clientes do contrato mensal cancelaram
# vamos dar descontos ao anual

# todos os clientes que atrasam 20 dias cancelam
# ligar um time pra ajudaar no décimo dia de atraso

# Kaggle

# callcenter - olhaar aa minha baase esxcluindo o problemaa do callcenter
tabela = tabela[tabela["ligacoes_callcenter"]<=4]

#dias_atraaso - olhaarr a minha baase excluindo o prrobblema dde dias_atraso
tabela = tabela[tabela["dias_atraso"]<=20]

#duracao_contrato - olhar a minha base excluindo contratos mensais
tabela = tabela[tabela["duracao_contrato"]!="Monthly"]


display(tabela["cancelou"].value_counts(normalize=True))
